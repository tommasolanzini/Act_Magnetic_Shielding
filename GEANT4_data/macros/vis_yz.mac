# 1. Setup the Viewer
/vis/open OGL 600x600-0+0
/vis/viewer/set/autoRefresh false
/vis/drawVolume
/vis/viewer/set/viewpointThetaPhi 60 45
/vis/viewer/zoom 1.5

# 2. Draw Trajectories (Smooth for magnetic curves)
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/scene/endOfEventAction accumulate

# 3. GPS Setup (Directional planar beam)
/gps/particle proton
/gps/energy 10 MeV
/gps/pos/type Plane
/gps/pos/shape Square

# Rotate the plane to face the X-axis (creating a Y-Z plane)
/gps/pos/rot1 0 1 0    # The plane's local 'x' is now the global Y-axis
/gps/pos/rot2 0 0 1    # The plane's local 'y' is now the global Z-axis

# Now halfx applies to global Y, and halfy applies to global Z
/gps/pos/halfx 15 cm
/gps/pos/halfy 15 cm
/gps/pos/centre 80. 0. 0. cm
/gps/direction -1 0 0

# /control/execute ../macros/vis_yz.mac