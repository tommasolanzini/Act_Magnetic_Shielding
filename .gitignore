# ==========================================
# 1. CMake & Build Directories
# ==========================================
# Ignores the entire build folder and all CMake generated files
build/
build_*/
out/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# ==========================================
# 2. Compiled C++ Binaries & Libraries
# ==========================================
# Prevents committing heavy executables and object files
*.exe
*.obj
*.o
*.dll
*.lib
*.a
*.so
*.dylib

# ==========================================
# 3. Geant4 Simulation Outputs
# ==========================================
# Ignore all massive data files generated by runs
*.csv
*.root
*.xml
*.hdf5
*_nt_*.csv

# ==========================================
# 4. Visual Studio / Windows IDE Files
# ==========================================
# Ignores files generated if you open CMake in Visual Studio
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo

# ==========================================
# 5. Python Caches & Virtual Environments
# ==========================================
# Ignores Python's compiled scripts and environment folders
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
geant4_env/

# ==========================================
# 6. OS Generated Files
# ==========================================
Thumbs.db
.DS_Store